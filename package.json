{
  "dependencies": {
    "cross-env": "^10.0.0"
  },
  "name": "@kajiyan/histpedia",
  "private": true,
  "scripts": {
    "app:analyze": "npm -w @kajiyan/histpedia-app run analyze",
    "app:build": "npm -w @kajiyan/histpedia-app run build",
    "app:dev": "npm -w @kajiyan/histpedia-app run dev",
    "app:export": "npm -w @kajiyan/histpedia-app run export",
    "app:preprod": "npm -w @kajiyan/histpedia-app run preprod",
    "app:start": "npm -w @kajiyan/histpedia-app run start",
    "app:server:delete": "npm -w @kajiyan/histpedia-app run server:delete",
    "app:server:launch": "npm -w @kajiyan/histpedia-app run server:launch",
    "app:server:logs": "npm -w @kajiyan/histpedia-app run server:logs",
    "lint": "npm run lint:script",
    "lint:script": "eslint --fix ."
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "prettier": "^2.0.5",
    "typescript-eslint": "^8.53.0"
  },
  "volta": {
    "node": "20.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
